# API Backend URL (Render endpoint in production, e.g. https://mindcare-api.onrender.com)
VITE_API_URL=http://localhost:3000

# WebSocket URL (optional, defaults to VITE_API_URL if omitted)
VITE_SOCKET_URL=http://localhost:3000

# Emergency hotline displayed across the UI (defaults to 1900 6789)
VITE_EMERGENCY_HOTLINE=1900 6789

