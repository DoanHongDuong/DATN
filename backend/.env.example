# Database connection string (PostgreSQL from Neon.tech in production, with ?sslmode=require)
DATABASE_URL="postgresql://username:password@ep-xyz.ap-southeast-1.aws.neon.tech/mindcare?sslmode=require"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# Server Port (Render automatically injects PORT=10000 or 3000)
PORT=3000
NODE_ENV=production

# AES-256 Journal Encryption Key (Must be 64 hex characters = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Google Gemini API Key for sentiment analysis
GEMINI_API_KEY="your-gemini-api-key-from-google-ai-studio"

# AI analysis timeout in milliseconds (default: 40000 = 40s)
AI_TIMEOUT_MS=40000

# Emergency Hotline (read by GET /support/emergency)
EMERGENCY_HOTLINE="1900 6789"

# Allowed Frontend Origins (comma-separated if multiple, e.g. local + Vercel)
FRONTEND_URL="http://localhost:5173,https://mindcare.vercel.app"

# Optional: Cloudflare R2 / S3 for Relaxation Audio/Media
R2_ACCESS_KEY=""
R2_SECRET_KEY=""
R2_BUCKET_NAME=""
